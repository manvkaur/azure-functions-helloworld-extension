<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Microsoft.Azure.Functions.Extensions.HelloWorld</AssemblyName>
    <RootNamespace>Microsoft.Azure.Functions.Extensions.HelloWorld</RootNamespace>
    <Description>Hello World extension for Azure Functions - A sample extension for new extension authors</Description>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Azure.WebJobs" Version="3.0.42" />
    <PackageReference Include="Microsoft.Azure.WebJobs.Extensions.Http" Version="3.2.1" />
  </ItemGroup>

</Project>
