<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Microsoft.Azure.Functions.Worker.Extensions.HelloWorld</AssemblyName>
    <Description>Hello World extension for Azure Functions isolated worker - A sample extension for new extension authors</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Abstractions" Version="1.3.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Core" Version="2.52.0" />
  </ItemGroup>

  <!-- Link to the WebJobs (host-side) extension for extension discovery -->
  <ItemGroup>
    <WebJobsReference Include="$(SrcRoot)Microsoft.Azure.Functions.Extensions.HelloWorld\Extensions.HelloWorld.csproj" />
  </ItemGroup>

</Project>
